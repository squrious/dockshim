# A shim whose alias was removed from the config reports it (no prompt without a terminal).
exec dockshim install
cp config2.yaml .dockshim.yaml
env PATH=$WORK/.dockshim/bin${:}$PATH
exec sh -c 'node; echo code=$?'
stdout '^code=127$'
stderr 'alias "node" is not defined in '$WORK'/.dockshim.yaml'
stderr 'is a stale shim, run `dockshim install` to remove it'
exists .dockshim/bin/node
! exists $FAKE_DOCKER_STATE/calls

# A copy outside .dockshim/bin still runs its alias, silently.
mkdir old
cp .dockshim/bin/php old/php
cp .dockshim/bin/node old/node
exec old/php
stdout '^target tools$'
! stderr .
! exec old/node
stderr 'old/node is a stale shim outside '$WORK'/.dockshim/bin, remove it manually'
exists old/node

-- .dockshim.yaml --
aliases:
  php: {service: tools}
  node: {service: tools}
-- config2.yaml --
aliases:
  php: {service: tools}
