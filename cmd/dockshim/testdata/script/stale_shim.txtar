# A shim whose alias was removed from the config fails like an unknown command, and tells how to
# remove it.
exec dockshim install
cp config2.yaml .dockshim.yaml
env PATH=$WORK/.dockshim/bin${:}$PATH
exec sh -c 'node; echo code=$?'
stdout '^code=127$'
stderr '^dockshim: alias "node" is not defined in '$WORK'/.dockshim.yaml: run `dockshim install` to remove its shim$'
exists .dockshim/bin/node
! exists $FAKE_DOCKER_STATE/calls

-- .dockshim.yaml --
aliases:
  php: {service: tools}
  node: {service: tools}
-- config2.yaml --
aliases:
  php: {service: tools}
