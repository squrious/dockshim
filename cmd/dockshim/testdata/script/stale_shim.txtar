# A shim whose alias was removed from the config fails like an unknown command. Without a
# terminal, nothing else is printed: the out-of-date warning is for humans only.
exec dockshim install
cp config2.yaml .dockshim.yaml
env PATH=$WORK/.dockshim/bin${:}$PATH
exec sh -c 'node; echo code=$?'
stdout '^code=127$'
stderr '^dockshim: alias "node" is not defined in '$WORK'/.dockshim.yaml$'
! stderr warning
exists .dockshim/bin/node
! exists $FAKE_DOCKER_STATE/calls

# A copy outside .dockshim/bin still runs its alias, silently, and fails the same way without it.
mkdir old
cp .dockshim/bin/php old/php
cp .dockshim/bin/node old/node
exec old/php
stdout '^target tools$'
! stderr .
! exec old/node
stderr '^dockshim: alias "node" is not defined in '$WORK'/.dockshim.yaml$'
! stderr warning

-- .dockshim.yaml --
aliases:
  php: {service: tools}
  node: {service: tools}
-- config2.yaml --
aliases:
  php: {service: tools}
