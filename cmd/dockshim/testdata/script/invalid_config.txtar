# Config errors are reported by any command that loads the config, all at once.
! exec dockshim config
stderr 'invalid config:'
stderr 'aliases.none.service: is required'
stderr 'aliases.php.path_mapping\[\.\]: container path "app" must be absolute'
stderr 'defaults.user: invalid user'

# Structural errors name config keys, not Go types.
cd $WORK/unknown
! exec dockshim config
stderr 'invalid config:'
stderr 'aliases\.php\.servce: unknown key, expected one of service, path_mapping, user, env, path_translation \(line 2\)'
stderr 'compose\.files: expected a list, got "a\.yaml" \(line 3\)'
! stderr 'config\.|!!'

# Aliases only target compose services.
cd $WORK/container
! exec dockshim config
stderr 'aliases\.node\.container: unknown key'

cd $WORK/ambiguous
! exec dockshim config
stderr 'ambiguous config'

cd $WORK/empty
exec dockshim config
stdout '^config +'$WORK'/empty/.dockshim.yml$'

cd $WORK/ambiguous
! exec dockshim bogus
stderr 'unknown command "bogus"'

-- .dockshim.yaml --
defaults:
  user: "not valid"
aliases:
  none: {}
  php:
    service: a
    path_mapping: {.: app}
-- unknown/.dockshim.yaml --
aliases:
  php: {servce: a}
compose: {files: a.yaml}
-- container/.dockshim.yaml --
aliases:
  node: {container: node}
-- ambiguous/.dockshim.yaml --
aliases: {php: {service: a}}
-- ambiguous/.dockshim.yml --
aliases: {php: {service: a}}
-- empty/.dockshim.yml --
