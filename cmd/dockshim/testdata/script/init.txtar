# init writes a valid starter .dockshim.yaml in the current directory, and nothing else.
exec dockshim init
stdout '^created '$WORK'/.dockshim.yaml$'
grep '^aliases:$' .dockshim.yaml
! exists .dockshim
exec dockshim validate
stdout 'is valid'

# Existing configs are protected.
! exec dockshim init
stderr '.dockshim.yaml already exists, use --force to overwrite'

cp custom.yaml .dockshim.yaml
exec dockshim init --force
! grep custom .dockshim.yaml

# A .yml config would make a second one ambiguous.
mkdir yml
cp custom.yaml yml/.dockshim.yml
! exec dockshim init -d yml
stderr 'yml/.dockshim.yml already exists, a second config file would be ambiguous'
! exists yml/.dockshim.yaml

# --dir picks the project directory.
mkdir other
exec dockshim init --dir other
stdout '^created '$WORK'/other/.dockshim.yaml$'
cd other
exec dockshim validate
stdout 'other/.dockshim.yaml is valid'
cd $WORK

! exec dockshim init -d missing
stderr 'missing: no such file or directory'
! exec dockshim init -d custom.yaml
stderr 'custom.yaml is not a directory'

-- custom.yaml --
# custom
aliases: {}
