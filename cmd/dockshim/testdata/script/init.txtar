# init writes a valid starter .dockshim.yaml in the current directory, and nothing else.
exec dockshim init
stdout '^created '$WORK'/.dockshim.yaml$'
grep '^aliases:$' .dockshim.yaml
! exists .dockshim
exec dockshim validate
stdout 'is valid'

# An existing config is never overwritten.
cp custom.yaml .dockshim.yaml
! exec dockshim init
stderr '.dockshim.yaml already exists'
grep custom .dockshim.yaml

# Nor is a second one created next to a .yml config.
mkdir yml
cp custom.yaml yml/.dockshim.yml
cd yml
! exec dockshim init
stderr 'yml/.dockshim.yml already exists'
! exists .dockshim.yaml

-- custom.yaml --
# custom
aliases: {}
