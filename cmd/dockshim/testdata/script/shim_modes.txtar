# Wrapper shims are /bin/sh scripts, and behave exactly like symlinks.
exec dockshim install
stdout '^created: gone, node, php$'
exec test -x .dockshim/bin/php
! exec test -L .dockshim/bin/php
grep '^#!/bin/sh$' .dockshim/bin/php
grep 'dockshim shim' .dockshim/bin/php
grep 'run --shim "\$0" php "\$@"' .dockshim/bin/php

# A symlink for node, in the same directory.
exec dockshim config node
stdout 'shim_mode: symlink'
exec test -L .dockshim/bin/node

env PATH=$WORK/.dockshim/bin${:}$PATH
env FOO=bar
cd src

# Same invocation through both modes, compared call by call, with the service already running.
exec php --warmup
rm $FAKE_DOCKER_STATE/calls
exec php -r 'echo 1;' $WORK/src/a.txt
cp $FAKE_DOCKER_STATE/calls wrapper-calls
rm $FAKE_DOCKER_STATE/calls
exec node -r 'echo 1;' $WORK/src/a.txt
cp $FAKE_DOCKER_STATE/calls symlink-calls
# Only the env forwarding order differs, because sh rebuilds the environment: compare token sets.
exec sh -c 'sed "s/ php / CMD /" wrapper-calls | tr " " "\n" | sort > w.txt; sed "s/ node / CMD /" symlink-calls | tr " " "\n" | sort > s.txt'
cmp w.txt s.txt

# Both modes are recognized, so switching mode rewrites the entry point and pruning removes either kind.
cd $WORK
cp config2.yaml .dockshim.yaml
exec dockshim install
stdout '^created: node, php$'
stdout '^removed: gone$'
! exists .dockshim/bin/gone
exec dockshim config php
stdout 'shim_mode: symlink'
exec test -L .dockshim/bin/php
! exec test -L .dockshim/bin/node
grep 'dockshim shim' .dockshim/bin/node

# An invalid mode is reported.
cp bad.yaml .dockshim.yaml
! exec dockshim validate
stderr 'aliases.php.shim_mode: invalid mode "script" \(expected symlink or wrapper\)'
cp config2.yaml .dockshim.yaml

# Stale wrapper shims report themselves like symlinks do.
cp config3.yaml .dockshim.yaml
exec sh -c 'node; echo code=$?'
stdout '^code=127$'
stderr 'alias "node" is not defined'
stderr 'is a stale shim, run `dockshim install` to remove it'

-- .dockshim.yaml --
global:
  shim_mode: wrapper
aliases:
  php:
    service: tools
    path_mapping: {.: /app}
  node:
    shim_mode: symlink
    service: tools
    path_mapping: {.: /app}
  gone:
    service: tools
-- config2.yaml --
global:
  shim_mode: symlink
aliases:
  php:
    service: tools
    path_mapping: {.: /app}
  node:
    shim_mode: wrapper
    service: tools
    path_mapping: {.: /app}
-- bad.yaml --
aliases:
  php: {service: tools, shim_mode: script}
-- config3.yaml --
aliases:
  php:
    service: tools
    path_mapping: {.: /app}
-- src/a.txt --
a
