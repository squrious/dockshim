# install makes .dockshim/bin hold exactly one shim per alias.
exec dockshim install
stdout '^created: composer, php$'
stdout '^'$WORK'/.dockshim/bin is not in PATH: add it to run the aliases by name.$'
exec test -x .dockshim/bin/php

# .dockshim/ holds generated files only, and git-ignores itself. An existing .gitignore is kept.
cmp .dockshim/.gitignore ignore-all
cp custom-ignore .dockshim/.gitignore
exec dockshim install
grep '^custom$' .dockshim/.gitignore
rm .dockshim/.gitignore
exec dockshim install
cmp .dockshim/.gitignore ignore-all

exec dockshim install
! stdout created

cp config2.yaml .dockshim.yaml
exec dockshim install
stdout '^created: node$'
stdout '^removed: composer$'
! exists .dockshim/bin/composer

# Anything else in .dockshim/bin is replaced or removed.
cp config2.yaml .dockshim/bin/node
cp config2.yaml .dockshim/bin/notes
exec dockshim install
stdout '^created: node$'
stdout '^removed: notes$'
! exists .dockshim/bin/notes

env PATH=$WORK/.dockshim/bin${:}$PATH
exec dockshim install
! stdout 'is not in PATH'

# install never manages a directory through a symlink.
mkdir $WORK/elsewhere
cp config2.yaml $WORK/elsewhere/keep
rm .dockshim/bin
symlink .dockshim/bin -> $WORK/elsewhere
! exec dockshim install
stderr '.dockshim/bin must be a directory: dockshim owns it'
exists $WORK/elsewhere/keep

-- .dockshim.yaml --
aliases:
  php: {service: tools}
  composer: {service: tools}
-- custom-ignore --
custom
-- ignore-all --
*
-- config2.yaml --
aliases:
  php: {service: tools}
  node: {service: node}
