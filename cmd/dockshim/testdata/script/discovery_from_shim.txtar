cd outer/project
# A shim finds the config of its own project even when run from outside it, and the container
# default workdir is kept.
exec dockshim install
mkdir $WORK/elsewhere
cd $WORK/elsewhere
exec $WORK/outer/project/.dockshim/bin/php
stdout '^target tools$'
! stdout 'workdir'

# A link to a shim belongs to the project of the shim.
symlink link -> $WORK/outer/project/.dockshim/bin/php
exec ./link
stdout '^target tools$'

# A relative path goes through links as the system does: hop/.. is the project, not elsewhere.
symlink hop -> $WORK/outer/project/src
exec hop/../.dockshim/bin/php
stdout '^target tools$'

# Manager commands walk up from the current directory instead.
! exec dockshim config
stderr 'no dockshim config found'

# A copy outside .dockshim/bin belongs to no project.
cp $WORK/outer/project/.dockshim/bin/php $WORK/elsewhere/php
! exec $WORK/elsewhere/php
stderr 'elsewhere/php is not in a \.dockshim/bin directory'

# Aliases run through their shims only.
cd $WORK/outer/project
rm $FAKE_DOCKER_STATE/calls
! exec dockshim run php
stderr '^dockshim: run only serves the entry points: call \.dockshim/bin/php instead$'
! exec dockshim run
stderr '^dockshim: run only serves the entry points: call \.dockshim/bin/<alias> instead$'
! exists $FAKE_DOCKER_STATE/calls
exec dockshim --help
! stdout '^  run '

# Nothing above the project is used: without its own config, a shim fails.
rm .dockshim.yaml
! exec .dockshim/bin/php
stderr 'outer/project: no dockshim config found'
! stdout .

-- outer/.dockshim.yaml --
aliases:
  php: {service: other}
-- outer/project/src/.keep --
-- outer/project/.dockshim.yaml --
aliases:
  php:
    service: tools
    path_mapping: {.: /app}
