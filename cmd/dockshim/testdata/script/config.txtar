# config prints a summary: defaults are left out, paths are relative to the root.
exec dockshim config
cmpenv stdout want.txt

# It takes no arguments.
! exec dockshim config php
stderr 'unknown command "php" for "dockshim config"'

-- .dockshim.yaml --
compose:
  files: [docker/compose.yaml]
  project_name: demo
defaults:
  user: 1000
  path_translation:
    allow: [/data]
  env: {A: defaults}
  env_forwarding:
    deny: [FOO, MISE_*]
aliases:
  php:
    service: tools
    path_mapping: {.: /app, assets: /assets/build}
    env: {A: alias}
  node:
    service: node
    user: "33:33"
    env_forwarding:
      allow: [SSH_AUTH_SOCK]
    path_translation:
      enabled: false
      allow: [/data2/]
-- want.txt --
config   $WORK/.dockshim.yaml
compose  project_name demo
         file docker/compose.yaml

node
  service           node
  user              33:33
  path_mapping      inferred from the container's bind mounts
  env               A
  env_forwarding    allow SSH_AUTH_SOCK
                    deny FOO, MISE_*
  path_translation  disabled

php
  service           tools
  user              1000
  path_mapping      . → /app
                    assets → /assets/build
  env               A
  env_forwarding    deny FOO, MISE_*
  path_translation  allow /data
