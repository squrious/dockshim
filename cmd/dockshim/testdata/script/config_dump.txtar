# The default output is a summary: defaults are left out, paths are relative to the root.
exec dockshim config
cmpenv stdout want.txt

exec dockshim config node
! stdout '^php$'
stdout '^  service +node$'

# --full prints everything, defaults included.
exec dockshim config --full
cmpenv stdout want.yaml

! exec dockshim config nope
stderr 'alias "nope" is not defined'

# --config works from anywhere.
cd /
exec dockshim --config $WORK/.dockshim.yaml validate
stdout 'is valid'

-- .dockshim.yaml --
compose:
  files: [docker/compose.yaml]
  project_name: demo
global:
  user: 1000
  path_translation:
    allow: [/data]
    max_copy_mb: 5
  env:
    deny: [FOO]
    vars: {A: global}
aliases:
  php:
    service: tools
    path_mapping: {.: /app, assets: /assets/build}
    env:
      vars: {A: alias}
  node:
    shim_mode: wrapper
    service: node
    user: "33:33"
    env:
      allow: [SSH_AUTH_SOCK]
    path_translation:
      enabled: false
      allow: [/data2/]
      follow_symlinks: true
-- want.txt --
config   $WORK/.dockshim.yaml
bin_dir  .dockshim/bin
compose  project_name demo
         file docker/compose.yaml

node
  service           node
  user              33:33
  path_mapping      inferred from the container's bind mounts
  shim_mode         wrapper
  env               allow SSH_AUTH_SOCK
                    deny FOO
                    vars A
  path_translation  disabled

php
  service           tools
  user              1000
  path_mapping      . → /app
                    assets → /assets/build
  env               deny FOO
                    vars A
  path_translation  allow /data
                    max_copy_mb 5
-- want.yaml --
root: $WORK
file: $WORK/.dockshim.yaml
bin_dir: $WORK/.dockshim/bin
compose:
  files:
    - $WORK/docker/compose.yaml
  project_name: demo
aliases:
  node:
    shim_mode: wrapper
    service: node
    user: "33:33"
    infer_path_mapping: true
    path_mapping: []
    env:
      deny:
        - PATH
        - HOME
        - PWD
        - OLDPWD
        - TMPDIR
        - TMP
        - TEMP
        - USER
        - LOGNAME
        - HOSTNAME
        - SHELL
        - SHLVL
        - _
        - LS_COLORS
        - FOO
      deny_prefixes:
        - COMPOSE_
        - DOCKER_
        - SSH_
        - XDG_
        - WSL
        - BASH_FUNC_
      allow:
        - SSH_AUTH_SOCK
    vars:
      A: global
    path_translation:
      enabled: false
      allow:
        - /data
        - /data2
      follow_symlinks: true
      max_copy_mb: 5
  php:
    shim_mode: symlink
    service: tools
    user: "1000"
    infer_path_mapping: false
    path_mapping:
      - host: $WORK
        container: /app
      - host: $WORK/assets
        container: /assets/build
    env:
      deny:
        - PATH
        - HOME
        - PWD
        - OLDPWD
        - TMPDIR
        - TMP
        - TEMP
        - USER
        - LOGNAME
        - HOSTNAME
        - SHELL
        - SHLVL
        - _
        - LS_COLORS
        - FOO
      deny_prefixes:
        - COMPOSE_
        - DOCKER_
        - SSH_
        - XDG_
        - WSL
        - BASH_FUNC_
      allow: []
    vars:
      A: alias
    path_translation:
      enabled: true
      allow:
        - /data
      follow_symlinks: false
      max_copy_mb: 5
